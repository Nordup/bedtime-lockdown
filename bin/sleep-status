#!/usr/bin/env bash
set -euo pipefail
SLEEP_LIB="${SLEEP_LIB:-$HOME/.local/share/sleep}"
SLEEP_HOME="${SLEEP_HOME:-$HOME/.config/sleep}"
. "$SLEEP_LIB/sleep-common.sh"

now=$(date +%s)
hhmm=$(date +%H%M)
active_win=$(current_window "$hhmm")

echo "Now:           $(date)"
echo "Active window: $active_win"
echo

# Print one block per window, scaled to fit on one screen.
print_window_block() {
    local label=$1 win=$2 start=$3 end=$4
    local window_label="$(format_hhmm_as_clock "$start") - $(format_hhmm_as_clock "$end")"
    local active="inactive"
    [[ "$active_win" == "$win" ]] && active="ACTIVE"
    printf '%-8s window %s   %s\n' "$label" "$window_label" "$active"

    if override_active "$now" "$win"; then
        local until
        until=$(<"$(override_until_path "$win")")
        printf '         override active until %s\n' "$(date -d "@$until" "+%H:%M")"
    else
        echo "         override: none"
    fi

    local remaining
    remaining=$(cooldown_remaining "$now" "$win")
    if (( remaining > 0 )); then
        printf '         cooldown: %s remaining\n' "$(format_hm "$remaining")"
    else
        echo "         cooldown: ready"
    fi

    local log_path today count
    log_path=$(overrides_log_path "$win")
    today=$(date +%Y-%m-%d)
    count=0
    if [[ -s "$log_path" ]]; then
        count=$(grep -c "^$today" "$log_path" || true)
    fi
    printf '         overrides today: %s\n' "$count"
}

print_window_block "Bedtime" bedtime "$LOCKDOWN_START_HHMM" "$LOCKDOWN_END_HHMM"
echo
print_window_block "Lunch" lunch "$LUNCH_START_HHMM" "$LUNCH_END_HHMM"
echo
print_window_block "Dinner" dinner "$DINNER_START_HHMM" "$DINNER_END_HHMM"

echo
echo "Last 5 enforce events:"
if [[ -s "$SLEEP_HOME/enforce.log" ]]; then
    tail -n 5 "$SLEEP_HOME/enforce.log"
else
    echo "  (none)"
fi

echo
echo "Last 5 overrides (across all windows):"
overrides=$(
    for win in bedtime lunch dinner; do
        f=$(overrides_log_path "$win")
        [[ -s "$f" ]] || continue
        # Tag each line with the window name so the merged view is readable.
        while IFS= read -r line; do
            printf '%s\t[%s]\t%s\n' "${line%%$'\t'*}" "$win" "${line#*$'\t'}"
        done < "$f"
    done | sort | tail -n 5
)
if [[ -n "$overrides" ]]; then
    echo "$overrides"
else
    echo "  (none)"
fi
