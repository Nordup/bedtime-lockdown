#!/usr/bin/env bash
set -euo pipefail
SLEEP_LIB="${SLEEP_LIB:-$HOME/.local/share/sleep}"
SLEEP_HOME="${SLEEP_HOME:-$HOME/.config/sleep}"
. "$SLEEP_LIB/sleep-common.sh"

mkdir -p "$SLEEP_HOME"

# Single-writer lock: prevents two concurrent invocations from both
# passing the cooldown check and double-appending to overrides.log.
exec 9>"$SLEEP_HOME/override.lock"
flock -n 9 || { echo "Another sleep-override is running. Try again." >&2; exit 1; }

now=$(date +%s)
remaining=$(cooldown_remaining "$now")
if (( remaining > 0 )); then
    printf 'Override already used. Cooldown remaining: %s\n' "$(format_hm "$remaining")" >&2
    exit 1
fi

# Read one non-empty answer for the given prompt. Empty / whitespace-only
# input is rejected and re-prompted.
read_answer() {
    local question=$1 answer
    while true; do
        read -r -p "$question " answer
        if [[ -n "${answer//[[:space:]]/}" ]]; then
            echo "$answer"
            return 0
        fi
        echo "  (answer cannot be empty)" >&2
    done
}

a1=$(read_answer "What are you doing right now?")
a2=$(read_answer "Why tonight specifically, and not tomorrow morning?")
a3=$(read_answer "What time will you actually stop?")

expires=$((now + OVERRIDE_DURATION_SEC))
ts=$(date -Iseconds)

printf '%s\t%s\t%s\t%s\n' "$ts" "$a1" "$a2" "$a3" >> "$SLEEP_HOME/overrides.log"
echo "$expires" > "$SLEEP_HOME/override-until"

echo "Override granted until $(date -d "@$expires" "+%H:%M"). Sleep well."
