[Unit]
Description=Bedtime enforce timer (every 5 min; the service is window-gated and a no-op outside 21:00-06:00)

[Timer]
# Monotonic timer pair, not OnCalendar. The wake-loop semantics we want
# are "5 minutes after the user wakes the machine" — measured from the
# moment of resume, not from an absolute clock mark. Because the script
# blocks on `systemctl suspend` until the kernel resumes, the service
# stays active for the entire suspend duration and only deactivates on
# resume. OnUnitInactiveSec=5min therefore schedules the next fire for
# exactly resume_time + 5min.
#
# OnActiveSec=5min gives the first fire 5 min after the timer is
# enabled (initial bootstrap). After that, OnUnitInactiveSec drives the
# cadence: 5 min between every service end and the next fire.
OnActiveSec=5min
OnUnitInactiveSec=5min
Unit=sleep-enforce.service

[Install]
WantedBy=timers.target
