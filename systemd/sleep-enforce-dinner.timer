[Unit]
Description=Exercise+dinner enforce kickoff timer (calendar-aligned daily fire at 16:30)

[Timer]
# Calendar trigger to guarantee the first lock of the dinner window
# lands at 16:30 exactly. The monotonic sleep-enforce.timer drives the
# every-5-min re-lock loop inside the window.
#
# Persistent=false: don't catch up if the machine was off at 16:30.
OnCalendar=*-*-* 16:30:00
Persistent=false
Unit=sleep-enforce.service

[Install]
WantedBy=timers.target
