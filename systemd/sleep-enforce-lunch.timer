[Unit]
Description=Lunch enforce kickoff timer (calendar-aligned daily fire at 11:30)

[Timer]
# Calendar trigger to guarantee the first lock of the lunch window
# lands at 11:30 exactly. The monotonic sleep-enforce.timer drives the
# every-5-min re-lock loop inside the window; this unit just plugs the
# phase-alignment gap at window start, the same way
# sleep-enforce-bedtime.timer does for 21:00.
#
# Persistent=false: don't catch up if the machine was off at 11:30.
OnCalendar=*-*-* 11:30:00
Persistent=false
Unit=sleep-enforce.service

[Install]
WantedBy=timers.target
